---
// The form posts to /api/contact. It works without JavaScript too (the page then reloads with a message).
---
<div id="contact-form-wrap">
  <div id="contact-status" role="status" aria-live="polite" class="mb-4 hidden rounded-2xl border px-4 py-3 text-sm font-semibold"></div>
  <form id="contact-form" action="/api/contact" method="post" class="space-y-5 rounded-3xl border border-brand-100 bg-white p-6 shadow-sm sm:p-8">
    <div>
      <label for="cf-name" class="mb-1.5 block text-sm font-bold text-ink">Your name</label>
      <input id="cf-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-base outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
    </div>
    <div>
      <label for="cf-email" class="mb-1.5 block text-sm font-bold text-ink">Your email</label>
      <input id="cf-email" name="email" type="email" required maxlength="200" autocomplete="email" class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-base outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
    </div>
    <div>
      <label for="cf-order" class="mb-1.5 block text-sm font-bold text-ink">Order number <span class="font-medium text-slate-500">(optional)</span></label>
      <input id="cf-order" name="order" type="text" maxlength="40" placeholder="For example #DD-1A2B3C" class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-base outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
    </div>
    <div>
      <label for="cf-message" class="mb-1.5 block text-sm font-bold text-ink">How can we help?</label>
      <textarea id="cf-message" name="message" required minlength="10" maxlength="5000" rows="6" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100"></textarea>
    </div>
    <!-- robots fill this hidden box; people never see it -->
    <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
      <label for="cf-website">Leave this empty</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button id="cf-send" type="submit" class="btn btn-primary w-full sm:w-auto">Send message</button>
    <p class="text-xs leading-relaxed text-slate-500">We use your name, email and message only to answer you. See our <a class="font-semibold text-brand-700" href="/privacy/">Privacy Policy</a>.</p>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const box = document.getElementById('contact-status') as HTMLDivElement | null;
  const send = document.getElementById('cf-send') as HTMLButtonElement | null;

  const show = (ok: boolean, text: string) => {
    if (!box) return;
    box.textContent = text;
    box.className = `mb-4 rounded-2xl border px-4 py-3 text-sm font-semibold ${ok ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-rose-200 bg-rose-50 text-rose-800'}`;
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  // the page reloads with ?sent=1 or ?error=1 when JavaScript is off
  const q = new URLSearchParams(location.search);
  if (q.get('sent')) show(true, 'Thank you. Your message was sent. We reply within 2 business days.');
  if (q.get('error')) show(false, 'We could not send your message. Please check the form, or email support@desidots.com.');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !send) return;
    send.disabled = true;
    const label = send.textContent;
    send.textContent = 'Sending...';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const out = await res.json().catch(() => ({ ok: false, message: 'Something went wrong. Please email support@desidots.com.' }));
      show(!!out.ok, out.message);
      if (out.ok) form.reset();
    } catch {
      show(false, 'We could not reach the server. Please try again, or email support@desidots.com.');
    } finally {
      send.disabled = false;
      send.textContent = label;
    }
  });
</script>
