---
import Icon from './Icon.astro';
const nav = [
  { href: '/#what', label: 'What you can do' },
  { href: '/#how', label: 'How it works' },
  { href: '/#sellers', label: 'For sellers' },
  { href: '/#faq', label: 'FAQ' },
];
const early = 'mailto:support@desidots.com?subject=DesiDots%20early%20access&body=Hi%2C%20please%20tell%20me%20when%20the%20DesiDots%20app%20is%20available.';
---
<header data-header class="sticky top-0 z-50 border-b border-brand-100/70 bg-[#fff8f0]/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between md:h-20">
    <a href="/" class="group flex items-center gap-3" aria-label="DesiDots home">
      <img src="/logo.png" alt="" width="40" height="40" class="h-10 w-10 rounded-xl transition group-hover:scale-105" />
      <span class="text-xl font-extrabold tracking-tight">Desi<span class="text-brand-600">Dots</span></span>
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {nav.map(n => <a href={n.href} class="text-sm font-medium text-muted transition hover:text-brand-600">{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={early} class="btn btn-primary hidden !py-2.5 sm:inline-flex">Get early access</a>
      <details class="relative md:hidden">
        <summary class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-ink" aria-label="Open menu"><Icon name="menu" /></summary>
        <div class="absolute right-0 mt-3 w-64 rounded-2xl border border-slate-100 bg-white p-3 shadow-xl">
          {nav.map(n => <a href={n.href} class="block rounded-xl px-4 py-3 text-sm font-semibold text-ink hover:bg-brand-50">{n.label}</a>)}
          <a href={early} class="btn btn-primary mt-2 w-full">Get early access</a>
        </div>
      </details>
    </div>
  </div>
</header>
