---
const year = new Date().getFullYear();
const policies = [
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms and Conditions' },
  { href: '/refunds/', label: 'Refund and Cancellation' },
  { href: '/shipping/', label: 'Shipping Policy' },
  { href: '/sellers/', label: 'Vendor Agreement' },
  { href: '/delete-account/', label: 'Delete your account' },
];
---
<footer class="border-t border-brand-100 bg-brand-50">
  <div class="container-x grid gap-10 py-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
        <span class="text-lg font-extrabold tracking-tight">Desi<span class="text-brand-600">Dots</span></span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">Indian stores in the USA, shopping direct from India, community events and trusted services, in one app.</p>
    </div>
    <nav class="md:col-span-4" aria-label="Policies">
      <h2 class="eyebrow mb-4">Policies</h2>
      <ul class="space-y-2.5 text-sm">
        {policies.map(p => <li><a href={p.href} class="text-muted transition hover:text-brand-600">{p.label}</a></li>)}
      </ul>
    </nav>
    <div class="md:col-span-3">
      <h2 class="eyebrow mb-4">Contact</h2>
      <ul class="space-y-2.5 text-sm">
        <li><a href="mailto:support@desidots.com" class="text-muted transition hover:text-brand-600">support@desidots.com</a></li>
        <li><a href="/contact/" class="text-muted transition hover:text-brand-600">Help and support</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-100">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Groccy Technologies, Inc., doing business as DesiDots. All rights reserved.</p>
      <p>101 S Burbank Dr, Unit C48, Montgomery, AL 36117, USA</p>
    </div>
  </div>
</footer>
